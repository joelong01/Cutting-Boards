{
  "name": "cutting-boards",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "npm run build && node scripts/run.mjs",
    "dev": "tsc -p electron && node scripts/run.mjs --dev",
    "build": "tsc --noEmit && tsc -p electron && vite build",
    "test": "vitest run",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "check": "vitest run && npm run smoke",
    "web": "vite --open",
    "icon": "node scripts/run.mjs --icon",
    "shortcut": "tsc -p electron && node scripts/run.mjs --shortcut-only"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "^33.4.11",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  },
  "main": "electron-dist/main.cjs",
  "productName": "Cutting Boards"
}
